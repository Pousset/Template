{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "App",
  "version": "0.1.0",
  "identifier": "com.portfolio.app",
 "build": {
  "frontendDist": "../../frontend/dist",
  "devUrl": "http://localhost:5173",
  "beforeDevCommand": "npm run dev:frontend --prefix ..",
  "beforeBuildCommand": "npm run build:frontend --prefix .."
},
  "app": {
    "windows": [
      {
        "title": "Template",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "resources": {
  "../../backend/dist-bin/*": "backend/"
},
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}