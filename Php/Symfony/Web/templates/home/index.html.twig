{% extends 'base.html.twig' %}

{% block title %}Accueil - {{ app_name }}{% endblock %}

{% block body %}
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Template web Symfony</p>
      <h1>Une base propre pour lancer un projet web structure.</h1>
      <p class="lead">Authentification, espace admin, dashboard et calendrier exemple sont deja organises par domaines pour rester maintenables.</p>
      <div class="actions">
        <a class="button primary" href="{{ path('app_register') }}">Demarrer</a>
        <a class="button ghost" href="{{ path('app_login') }}">Se connecter</a>
      </div>
    </div>
    <div class="hero-panel">
      <div class="metric">
        <span class="metric-value">4</span>
        <span class="metric-label">Domaines applicatifs</span>
      </div>
      <div class="metric">
        <span class="metric-value">2</span>
        <span class="metric-label">Roles prets</span>
      </div>
      <div class="metric">
        <span class="metric-value">1</span>
        <span class="metric-label">Calendrier exemple</span>
      </div>
    </div>
  </section>
{% endblock %}

