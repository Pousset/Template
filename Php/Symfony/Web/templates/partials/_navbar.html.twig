<header class="site-header">
  <a class="brand" href="{{ path('app_home') }}">
    <span class="brand-mark">ST</span>
    <span>Symfony Template</span>
  </a>
  <nav class="nav-links">
    <a href="{{ path('app_home') }}">Accueil</a>
    {% if app.user %}
      <a href="{{ path('app_dashboard') }}">Dashboard</a>
      <a href="{{ path('app_calendar') }}">Calendrier</a>
      {% if is_granted('ROLE_ADMIN') %}
        <a href="{{ path('app_admin') }}">Admin</a>
      {% endif %}
      <a href="{{ path('app_logout') }}">Deconnexion</a>
    {% else %}
      <a href="{{ path('app_login') }}">Connexion</a>
      <a class="nav-cta" href="{{ path('app_register') }}">Creer un compte</a>
    {% endif %}
  </nav>
</header>

