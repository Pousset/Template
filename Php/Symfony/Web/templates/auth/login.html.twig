{% extends 'base.html.twig' %}

{% block title %}Connexion - {{ app_name }}{% endblock %}

{% block body %}
  <section class="auth-layout">
    <form class="auth-card" method="post">
      <div>
        <p class="eyebrow">Connexion</p>
        <h1>Retour dans votre espace.</h1>
      </div>

      {% if error %}
        <div class="alert alert-error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
      {% endif %}

      <label>
        Email
        <input type="email" name="email" value="{{ last_username }}" autocomplete="email" required autofocus>
      </label>
      <label>
        Mot de passe
        <input type="password" name="password" autocomplete="current-password" required>
      </label>
      <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
      <button class="button primary full" type="submit">Se connecter</button>
      <p class="muted">Pas encore de compte ? <a href="{{ path('app_register') }}">Creer un compte</a></p>
    </form>
  </section>
{% endblock %}

