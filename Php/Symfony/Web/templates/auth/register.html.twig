{% extends 'base.html.twig' %}

{% block title %}Inscription - {{ app_name }}{% endblock %}

{% block body %}
  <section class="auth-layout">
    <form class="auth-card" method="post">
      <div>
        <p class="eyebrow">Inscription</p>
        <h1>Creer votre compte.</h1>
      </div>
      <label>
        Nom affiche
        <input type="text" name="displayName" autocomplete="name" required>
      </label>
      <label>
        Email
        <input type="email" name="email" autocomplete="email" required>
      </label>
      <label>
        Mot de passe
        <input type="password" name="password" autocomplete="new-password" minlength="8" required>
      </label>
      <input type="hidden" name="_csrf_token" value="{{ csrf_token('register') }}">
      <button class="button primary full" type="submit">Creer le compte</button>
      <p class="muted">Deja inscrit ? <a href="{{ path('app_login') }}">Se connecter</a></p>
    </form>
  </section>
{% endblock %}
