{% extends 'base.html.twig' %}

{% block title %}Créer un compte — {{ app_name }}{% endblock %}

{% block body %}
<div class="auth-layout">
  <div class="auth-card">
    <div class="auth-card-header">
      <p class="eyebrow">// Inscription</p>
      <h1>Rejoins l'espace.</h1>
    </div>

    {% if errors is defined and errors|length > 0 %}
      <div class="flash flash-error">
        <ul style="margin:0;padding-left:1.2em">
          {% for err in errors %}
            <li>{{ err }}</li>
          {% endfor %}
        </ul>
      </div>
    {% endif %}

    <form method="post" action="{{ path('app_register') }}">
      <input type="hidden" name="_csrf_token" value="{{ csrf_token('register') }}">

      <div class="form-group">
        <label for="display_name">Nom d'affichage</label>
        <input id="display_name" type="text" name="display_name"
               placeholder="John Doe" autocomplete="name">
      </div>

      <div class="form-group">
        <label for="username">
          Nom d'utilisateur
          <span class="label-hint">3-50 caractères, lettres, chiffres, _ ou -</span>
        </label>
        <input id="username" type="text" name="username"
               required pattern="[a-zA-Z0-9_\-]{3,50}"
               placeholder="johndoe" autocomplete="username">
      </div>

      <div class="form-group">
        <label for="email">Adresse e-mail</label>
        <input id="email" type="email" name="email"
               required placeholder="toi@exemple.com" autocomplete="email">
      </div>

      <div class="form-group">
        <label for="password">
          Mot de passe
          <span class="label-hint">8 caractères min.</span>
        </label>
        <input id="password" type="password" name="password"
               required minlength="8" placeholder="••••••••" autocomplete="new-password">
      </div>

      <div class="form-group">
        <label for="password_confirm">Confirmer le mot de passe</label>
        <input id="password_confirm" type="password" name="password_confirm"
               required placeholder="••••••••" autocomplete="new-password">
      </div>

      <button type="submit" class="btn btn-primary btn-full">Créer mon compte</button>
    </form>

    <p class="auth-footer">
      Déjà un compte ?
      <a href="{{ path('app_login') }}">Se connecter</a>
    </p>
  </div>
</div>
{% endblock %}
