{% extends 'base.html.twig' %}

{% block title %}Dashboard — {{ app_name }}{% endblock %}

{% block body %}
<div class="page-centered">
  <div class="card-large">

    <div class="card-header">
      <p class="eyebrow">// Dashboard</p>
      <h1>Bonjour, <span class="accent">{{ app.user.displayName }}</span> 👋</h1>
      <p class="muted">Connecté en tant que <strong>{{ app.user.username }}</strong> &bull; {{ app.user.email }}</p>
    </div>

    <div class="stat-grid">
      <div class="stat-card">
        <span class="stat-label">Rôle</span>
        <span class="stat-value">
          {% if is_granted('ROLE_ADMIN') %}
            <span class="badge badge-admin">Admin</span>
          {% else %}
            <span class="badge badge-user">Utilisateur</span>
          {% endif %}
        </span>
      </div>
      <div class="stat-card">
        <span class="stat-label">Membre depuis</span>
        <span class="stat-value">{{ app.user.createdAt|date('d/m/Y') }}</span>
      </div>
      <div class="stat-card">
        <span class="stat-label">Identifiant</span>
        <span class="stat-value mono">{{ app.user.username }}</span>
      </div>
    </div>

    <div class="card-actions">
      {% if is_granted('ROLE_ADMIN') %}
        <a href="{{ path('app_admin') }}" class="btn btn-primary">Accès admin →</a>
      {% endif %}

      <form method="post" action="{{ path('app_logout') }}" style="display:inline">
        <button type="submit" class="btn btn-ghost">Se déconnecter</button>
      </form>
    </div>

  </div>
</div>
{% endblock %}
