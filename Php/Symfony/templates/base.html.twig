<!doctype html>
<html lang="fr" class="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}{{ app_name }}{% endblock %}</title>
  <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
</head>
<body>

  {# ── Navbar ── #}
  <header class="site-header">
    <div class="brand">
      <div class="brand-mark">S</div>
      <span>{{ app_name }}</span>
    </div>

    <nav class="nav-links">
      <a href="{{ path('app_home') }}">Accueil</a>
      {% if app.user %}
        <a href="{{ path('app_dashboard') }}">Dashboard</a>
        {% if is_granted('ROLE_ADMIN') %}
          <a href="{{ path('app_admin') }}">Admin</a>
        {% endif %}
      {% endif %}
    </nav>

    <div class="header-actions">
      {% if app.user %}
        <a href="{{ path('app_logout') }}" class="btn btn-ghost">Se déconnecter</a>
      {% else %}
        <a href="{{ path('app_login') }}" class="btn btn-ghost">Se connecter</a>
        <a href="{{ path('app_register') }}" class="btn btn-primary">Créer un compte</a>
      {% endif %}
      <button class="btn btn-ghost btn-icon" id="theme-toggle" title="Basculer le thème">
        <span id="icon-sun" style="display:none">☀</span>
        <span id="icon-moon">☾</span>
      </button>
    </div>
  </header>

  {# ── Contenu principal ── #}
  <main class="page-shell">
    {% for label, messages in app.flashes %}
      {% for message in messages %}
        <div class="flash flash-{{ label }}">{{ message }}</div>
      {% endfor %}
    {% endfor %}

    {% block body %}{% endblock %}
  </main>

  {# ── Footer ── #}
  <footer class="site-footer">
    <p>{{ app_name }} &mdash; {{ 'now'|date('Y') }}</p>
  </footer>

  {# ── Script thème dark/light ── #}
  <script>
    (function () {
      const html     = document.documentElement;
      const toggle   = document.getElementById('theme-toggle');
      const iconSun  = document.getElementById('icon-sun');
      const iconMoon = document.getElementById('icon-moon');

      function applyTheme(isDark) {
        if (isDark) {
          html.classList.add('dark');
          iconSun.style.display  = 'inline';
          iconMoon.style.display = 'none';
        } else {
          html.classList.remove('dark');
          iconSun.style.display  = 'none';
          iconMoon.style.display = 'inline';
        }
      }

      const saved = localStorage.getItem('theme') ?? 'dark';
      applyTheme(saved === 'dark');

      toggle.addEventListener('click', function () {
        const isDark = !html.classList.contains('dark');
        applyTheme(isDark);
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      });
    })();
  </script>

</body>
</html>