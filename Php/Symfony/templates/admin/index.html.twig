{% extends 'base.html.twig' %}

{% block title %}Admin — {{ app_name }}{% endblock %}

{% block body %}
<div class="page-centered">
  <div class="card-large">

    <div class="card-header">
      <p class="eyebrow">// Espace Admin</p>
      <h1>Panel <span class="accent">Admin</span></h1>
      <p class="muted">Connecté en tant que <strong>{{ app.user.username }}</strong></p>
    </div>

    {# ── Stats ── #}
    <div class="stat-grid">
      <div class="stat-card">
        <span class="stat-label">Utilisateurs total</span>
        <span class="stat-value mono">{{ total_users }}</span>
      </div>
      <div class="stat-card">
        <span class="stat-label">Admins</span>
        <span class="stat-value mono">{{ total_admins }}</span>
      </div>
      <div class="stat-card">
        <span class="stat-label">Utilisateurs</span>
        <span class="stat-value mono">{{ total_users - total_admins }}</span>
      </div>
    </div>

    {# ── Liste des utilisateurs ── #}
    <div class="table-wrapper">
      <table class="data-table">
        <thead>
          <tr>
            <th>#</th>
            <th>Nom d'affichage</th>
            <th>Identifiant</th>
            <th>E-mail</th>
            <th>Rôle</th>
            <th>Inscrit le</th>
          </tr>
        </thead>
        <tbody>
          {% for user in users %}
          <tr>
            <td class="mono">{{ user.id }}</td>
            <td>{{ user.displayName }}</td>
            <td class="mono">{{ user.username }}</td>
            <td>{{ user.email }}</td>
            <td>
              {% if user.isAdmin %}
                <span class="badge badge-admin">Admin</span>
              {% else %}
                <span class="badge badge-user">User</span>
              {% endif %}
            </td>
            <td class="muted">{{ user.createdAt|date('d/m/Y') }}</td>
          </tr>
          {% else %}
          <tr>
            <td colspan="6" class="muted" style="text-align:center;padding:2rem">Aucun utilisateur.</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>

    <div class="card-actions">
      <a href="{{ path('app_dashboard') }}" class="btn btn-ghost">← Dashboard</a>

      <form method="post" action="{{ path('app_logout') }}" style="display:inline">
        <button type="submit" class="btn btn-ghost btn-danger">Se déconnecter</button>
      </form>
    </div>

  </div>
</div>
{% endblock %}
